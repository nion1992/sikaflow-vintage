# ── Convex backend ─────────────────────────────────────────────
# VITE_CONVEX_URL is the URL of your Convex deployment (or local dev server).
# Run 'npx convex dev' to get the local URL, or find it in the Convex dashboard.
VITE_CONVEX_URL=http://127.0.0.1:3210

# ── Supabase Auth (replaces Convex Auth) ───────────────────────
# Public browser config. The anon/publishable key is safe to expose: it only
# identifies the project. Sign-in (password, email OTP, magic link) happens in
# the browser; Convex verifies the resulting access token.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Convex deployment env vars (NOT read from this file) ───────
# Set these on the deployment itself, e.g.
#   npx convex env set SUPABASE_URL https://your-project.supabase.co
#
# SUPABASE_URL              required — JWKS issuer for verifying access tokens
# SUPABASE_SERVICE_ROLE_KEY optional — only for off-site JSON snapshots
#                                       (src/convex/supabaseSync.ts)
#
# Never prefix the service-role key with VITE_ and never commit it.

# ── Obsolete (no longer used; remove if present) ───────────────
# CONVEX_SITE_URL     — was used by Convex Auth; no longer needed.
# CONVEX_DEPLOYMENT   — keep only if you still run 'npx convex dev' locally.
CONVEX_DEPLOYMENT=
